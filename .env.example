# Gemini AI Configuration
# Get your API key from: https://ai.google.dev/
# IMPORTANT: Use GEMINI_API_KEY (server-side only, not exposed to browser)
# Set this in Vercel Dashboard > Settings > Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here

# Resend Configuration (for Contact Form — Vercel Serverless)
# Sign up free at: https://resend.com — 3,000 emails/month, 100/day free tier
# 1. Create account and verify your domain (or use onboarding@resend.dev for testing)
# 2. Go to API Keys > Create API Key
# 3. Set CONTACT_EMAIL to the address where you want to receive messages
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_EMAIL=your_email@gmail.com

# Portfolio Configuration
REACT_APP_PORTFOLIO_MODE=production
